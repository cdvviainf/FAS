generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS Y AUTH ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth fields
  emailVerified Boolean   @default(false)
  image         String?
  // admin plugin
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── AUTORIZACIÓN: ÍTEMS DE MENÚ, PERFILES Y USUARIOS ───────────────────────

enum NivelAcceso {
  SIN_ACCESO
  LECTURA
  TOTAL
}

model ItemMenu {
  id       Int            @id @default(autoincrement())
  codigo   String         @unique
  nombre   String
  seccion  String
  ruta     String?
  esAccion Boolean        @default(false)
  orden    Int            @default(0)
  activo   Boolean        @default(true)
  accesos  PerfilAcceso[]

  @@map("items_menu")
}

model Perfil {
  id             Int            @id @default(autoincrement())
  codigo         String
  descripcion    String
  accesos        PerfilAcceso[]
  usuarios       Usuario[]
  creadoEn       DateTime       @default(now())
  creadoPor      String
  actualizadoEn  DateTime?      @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@map("perfiles")
}

model PerfilAcceso {
  id         Int         @id @default(autoincrement())
  perfilId   Int
  perfil     Perfil      @relation(fields: [perfilId], references: [id])
  itemMenuId Int
  itemMenu   ItemMenu    @relation(fields: [itemMenuId], references: [id])
  nivel      NivelAcceso @default(SIN_ACCESO)

  @@unique([perfilId, itemMenuId])
  @@map("perfil_accesos")
}

model Usuario {
  id                      String    @id
  nombre                  String
  email                   String
  whatsapp                String?
  imagenUrl               String?
  perfilId                Int
  perfil                  Perfil    @relation(fields: [perfilId], references: [id])
  esResponsableVenta      Boolean   @default(false)
  // Empresa activa por defecto al iniciar sesión (multi-empresa). Nullable:
  // un usuario recién creado puede no tener empresas asignadas todavía.
  empresaPredeterminadaId Int?
  empresaPredeterminada   Empresa?  @relation("UsuarioEmpresaPredeterminada", fields: [empresaPredeterminadaId], references: [id])
  creadoEn                DateTime  @default(now())
  creadoPor               String?
  actualizadoEn           DateTime? @updatedAt
  actualizadoPor          String?
  eliminadoEn             DateTime?
  eliminadoPor            String?

  solicitudesAsignadas          SolicitudInspeccionAsignado[]
  solicitudesComoSolicitante    SolicitudInspeccion[]         @relation("SolicitudInspeccionSolicitante")
  avatar                        UsuarioAvatar?
  ordenesCompraResponsable      OrdenCompra[]
  contratosProductorResponsable ProductorContrato[]
  empresas                      UsuarioEmpresa[]

  @@index([empresaPredeterminadaId])
  @@map("usuarios")
}

// Avatar del usuario (UP7): metadata en Usuario.imagenUrl (ruta de servido, no editable
// manualmente), binario aquí — mismo patrón que DocumentoArticulo/DocumentoArticuloContenido.
model UsuarioAvatar {
  usuarioId String   @id
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mime      String
  tamano    Int
  datos     Bytes
  creadoEn  DateTime @default(now())

  @@map("usuarios_avatar")
}

// ─── EMPRESAS (multi-empresa / multi-tenant) ─────────────────────────────────
// El sistema opera para dos empresas del cliente (Frutera Agrosan y AGDry),
// cada una con sus propios maestros, transacciones y configuraciones. Fase 0:
// se crea el modelo de Empresa + membresía de usuarios. El scoping por
// `empresaId` en el resto de las tablas se agrega en la fase de tenancy.
model Empresa {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  razonSocial    String
  nombreFantasia String?
  rut            String?
  giro           String?
  email          String?
  telefono       String?
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  direcciones            EmpresaDireccion[]
  contactos              EmpresaContacto[]
  usuarios               UsuarioEmpresa[]
  usuariosPredeterminada Usuario[]                   @relation("UsuarioEmpresaPredeterminada")
  mercados               Mercado[]
  gruposMercado          GrupoMercado[]
  configuracionesCorreo  ConfiguracionCorreo[]
  prefijosCodigo         PrefijoCodigo[]
  mercadoPaises          MercadoPais[]
  tiposEmbarque          TipoEmbarque[]
  formasPago             FormaPago[]
  unidadesMedida         UnidadMedida[]
  tiposPallet            TipoPallet[]
  etiquetas              Etiqueta[]
  alturas                Altura[]
  tiposProduccion        TipoProduccion[]
  tiposDefecto           TipoDefecto[]
  tiposParametro         TipoParametro[]
  puertos                Puerto[]
  temporadas             Temporada[]
  bodegas                Bodega[]
  conceptosCtaCte        ConceptoCtaCte[]
  especies               Especie[]
  gruposVariedad         GrupoVariedad[]
  variedades             Variedad[]
  categorias             Categoria[]
  calibres               Calibre[]
  parametros             Parametro[]
  calificaciones         Calificacion[]
  entidades              Entidad[]
  solicitudesInspeccion  SolicitudInspeccion[]
  articulos              Articulo[]
  recetas                Receta[]
  tiposMovimiento        TipoMovimiento[]
  saldosArticulo         SaldoArticulo[]
  movimientos            Movimiento[]
  predios                Predio[]
  contratosProductor     ProductorContrato[]
  movimientosCC          MovimientoCuentaCorriente[]
  conceptosLiquidacion   ConceptoLiquidacion[]
  notasVenta             NotaVenta[]
  embarques              Embarque[]
  instructivosEmbalaje   InstructivoEmbalaje[]
  ordenesCompra          OrdenCompra[]
  condicionesPago        CondicionPago[]
  recepciones            Recepcion[]
  pallets                Pallet[]
  templatesCarga         TemplateCarga[]
  documentosEmitidos     DocumentoEmitido[]
  logo                   EmpresaLogo?

  @@map("empresas")
}

// Logo de marca para el Encabezado de los documentos PDF (Motor de
// Documentos, Etapa 4 §12 — "pendiente manual de marca"). Tabla separada de
// Empresa (mismo patrón que RecepcionAdjuntoContenido/DocumentoEmitido.pdf)
// para que las queries normales de Empresa (listados, selector de header)
// no arrastren el binario. Un logo por empresa — subir uno nuevo reemplaza
// al anterior (no hay historial).
model EmpresaLogo {
  empresaId Int      @id
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mime      String
  datos     Bytes
  subidoEn  DateTime @default(now())
  subidoPor String

  @@map("empresa_logos")
}

model EmpresaDireccion {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  codigo         String
  descripcion    String // etiqueta legible, ej. "Casa matriz"
  paisId         Int
  pais           Pais      @relation("EmpresaDireccionPais", fields: [paisId], references: [id])
  comunaId       Int?
  comuna         Comuna?   @relation("EmpresaDireccionComuna", fields: [comunaId], references: [id])
  direccion      String
  esPorDefecto   Boolean   @default(false)
  latitud        Decimal?  @db.Decimal(10, 7)
  longitud       Decimal?  @db.Decimal(10, 7)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([empresaId])
  @@map("empresa_direcciones")
}

model EmpresaContacto {
  id                   Int       @id @default(autoincrement())
  empresaId            Int
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  codigo               String
  nombre               String
  rut                  String?
  whatsapp             String?
  email                String?
  telefono             String?
  tipo                 String?
  esRepresentanteLegal Boolean   @default(false)
  creadoEn             DateTime  @default(now())
  creadoPor            String
  actualizadoEn        DateTime? @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?

  @@index([empresaId])
  @@map("empresa_contactos")
}

// Membresía N:M — un usuario puede tener acceso a una empresa, a ambas, o a
// ninguna todavía. El perfil/permisos son globales por usuario (decisión de
// negocio 2026-07-31), por lo que aquí NO se guarda perfil por empresa.
model UsuarioEmpresa {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  creadoEn  DateTime @default(now())
  creadoPor String

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@map("usuario_empresas")
}

// ─── ENTIDADES MAESTRAS ──────────────────────────────────────────────────────

model Productor {
  id           String    @id @default(cuid())
  rut          String    @unique
  nombre       String
  razonSocial  String
  email        String?
  telefono     String?
  direccion    String?
  comuna       String?
  region       String?
  banco        String?
  tipoCuenta   String?
  numeroCuenta String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Cliente {
  id        String      @id @default(cuid())
  codigo    String      @unique
  nombre    String
  pais      String
  mercado   MercadoType
  email     String?
  contacto  String?
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
}

enum MercadoType {
  SUDAMERICA
  NORTEAMERICA
  EUROPA
  ASIA
  OTRO
}

model EspecieLegacy {
  id     String  @id @default(cuid())
  nombre String  @unique
  activo Boolean @default(true)

  variedades VariedadLegacy[]

  @@map("legacy_especies")
}

model VariedadLegacy {
  id         String        @id @default(cuid())
  nombre     String
  especieId  String
  especie    EspecieLegacy @relation(fields: [especieId], references: [id])
  activo     Boolean       @default(true)
  stockLotes StockLote[]

  @@unique([nombre, especieId])
  @@map("legacy_variedades")
}

// ─── OPERACIONES / STOCK ─────────────────────────────────────────────────────

model StockLote {
  id             String         @id @default(cuid())
  codigo         String         @unique
  variedadId     String
  variedad       VariedadLegacy @relation(fields: [variedadId], references: [id])
  temporada      String
  fechaRecepcion DateTime
  calibre        String?
  categoria      String?
  cantidadCajas  Decimal        @db.Decimal(18, 4)
  pesoNeto       Decimal?       @db.Decimal(18, 4)
  estadoCalidad  CalidadEstado  @default(PENDIENTE)
  observaciones  String?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  movimientos StockMovimiento[]
}

enum CalidadEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
  APROBADO_CONDICIONADO
}

model StockMovimiento {
  id            String         @id @default(cuid())
  loteId        String
  lote          StockLote      @relation(fields: [loteId], references: [id])
  tipo          MovimientoTipo
  cantidad      Decimal        @db.Decimal(18, 4)
  referencia    String?
  observaciones String?
  createdBy     String
  createdAt     DateTime       @default(now())
}

enum MovimientoTipo {
  INGRESO
  DESPACHO_EXPORTACION
  MERMA
  AJUSTE
}

// ─── MATERIALES ──────────────────────────────────────────────────────────────

model Material {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombre         String
  unidad         String
  precioUnitario Decimal  @db.Decimal(18, 4)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── FINANZAS / COSTOS ───────────────────────────────────────────────────────

model CostoOperacional {
  id          String   @id @default(cuid())
  tipo        String
  descripcion String
  monto       Decimal  @db.Decimal(18, 4)
  moneda      String   @default("USD")
  fecha       DateTime
  referencia  String?
  notaVentaId String?
  createdBy   String
  createdAt   DateTime @default(now())
}

// ─── CALIDAD ─────────────────────────────────────────────────────────────────

model InspeccionCalidad {
  id              String        @id @default(cuid())
  loteId          String        @unique
  fecha           DateTime
  inspector       String
  temperatura     Decimal?      @db.Decimal(5, 2)
  brix            Decimal?      @db.Decimal(5, 2)
  firmeza         String?
  coloracion      String?
  presenciaPlagas Boolean       @default(false)
  resultado       CalidadEstado
  observaciones   String?
  createdBy       String
  createdAt       DateTime      @default(now())
}

// ─── CONFIGURACIÓN / MANTENEDORES SIMPLES ───────────────────────────────────

model Pais {
  id                    Int       @id @default(autoincrement())
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  // Semánticas independientes (antes un único esPaisOrigen sobrecargado):
  // esPaisNacional = "es Chile" (único, exige RUT/comunas chilenas).
  // puedeSerOrigen = filtro de puertos R9 (multi-país, un puerto puede
  // servir de origen y destino a la vez sin heredar reglas de RUT/comunas).
  esPaisNacional        Boolean   @default(false)
  puedeSerOrigen        Boolean   @default(false)
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  // Pais.mercadoId (FK directo global->tenant) fue reemplazado en Fase 2b por
  // MercadoPais: a qué mercado pertenece un país es una decisión comercial de
  // cada empresa (Mercado es por-empresa desde Fase 2a), Pais sigue siendo
  // geografía global (Docs/empresas.md §5).
  mercadoPaises MercadoPais[]

  puertos                   Puerto[]
  entidades                 Entidad[]                 @relation("EntidadPais")
  entidadDirecciones        EntidadDireccion[]        @relation("DireccionPais")
  empresaDirecciones        EmpresaDireccion[]        @relation("EmpresaDireccionPais")
  notasVenta                NotaVenta[]
  solicitudesInspeccionPais SolicitudInspeccionPais[]

  @@map("paises")
}

// ─── País ↔ Mercado (Fase 2b) ────────────────────────────────────────────────
// Cada empresa mapea sus países a sus mercados. Un país pertenece a lo sumo un
// mercado POR EMPRESA (decisión de negocio 2026-08-01) — no es N:M real: la
// misma fila de País puede mapear a mercados distintos en empresas distintas,
// pero dentro de una empresa el mapeo es 1:1 (@@unique([empresaId, paisId])).
// Sin soft-delete: cambiar el mercado de un país es un UPDATE de esta misma
// fila, no un alta/baja.
model MercadoPais {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  mercadoId      Int
  mercado        Mercado   @relation(fields: [mercadoId], references: [id])
  paisId         Int
  pais           Pais      @relation(fields: [paisId], references: [id])
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?

  @@unique([empresaId, paisId])
  @@index([empresaId, mercadoId])
  @@map("mercado_paises")
}

model Zona {
  id                    Int       @id @default(autoincrement())
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  predios Predio[]

  @@map("zonas")
}

model GrupoMercado {
  id                    Int       @id @default(autoincrement())
  // empresaId + codigo: único solo entre filas activas (índice parcial en la
  // migración, mismo patrón que PrefijoCodigo — no representable en el DSL
  // de Prisma). Mercado/GrupoMercado pasan a ser por empresa (Fase 2,
  // Docs/empresas.md decisión #4).
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  mercados             Mercado[]
  instructivosEmbalaje InstructivoEmbalaje[]

  // Target de la FK compuesta de Mercado (empresaId, grupoMercadoId) — hace
  // estructuralmente imposible que un Mercado y su GrupoMercado pertenezcan a
  // empresas distintas, aunque una escritura anidada de Prisma bypasee la
  // extensión de tenancy (FAS-EMP-F2-R3-005).
  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("grupos_mercado")
}

model TipoEmbarque {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  puertos        Puerto[]
  notasVenta     NotaVenta[]
  prefijosCodigo PrefijoCodigo[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("tipos_embarque")
}

model FormaPago {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  ordenesCompra OrdenCompra[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("formas_pago")
}

model UnidadMedida {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  especies                Especie[]                @relation("UnidadMedidaCalidadEspecie")
  articulos               Articulo[]
  contratoProductorLineas ProductorContratoLinea[]
  condicionPagoCuotas     CondicionPagoCuota[]
  ordenCompraCuotasPago   OrdenCompraCuotaPago[]
  notaVentaCuotasPago     NotaVentaCuotaPago[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("unidades_medida")
}

model TipoPallet {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  notaVentaDetalles           NotaVentaDetalle[]
  ordenCompraLineas           OrdenCompraLinea[]
  instructivoEmbalajeDetalles InstructivoEmbalajeDetalle[]

  @@index([empresaId])
  @@map("tipos_pallet")
}

model Etiqueta {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  articulos Articulo[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("etiquetas")
}

model Altura {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  instructivoEmbalajeDetalles InstructivoEmbalajeDetalle[]

  @@index([empresaId])
  @@map("alturas")
}

model TipoProduccion {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
