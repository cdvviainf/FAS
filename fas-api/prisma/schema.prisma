// Configura, por cada mantenedor/módulo que use campo `codigo`, un prefijo
// fijo + cantidad de dígitos del correlativo (ej. Entidad: "EN" + 3 dígitos
// -> EN001, EN002...). El formulario de creación de ese mantenedor consulta
// el siguiente correlativo disponible como sugerencia (editable).
model PrefijoCodigo {
  id             Int           @id @default(autoincrement())
  // Sin @unique de Prisma (no soporta índices parciales en el DSL) — la
  // unicidad real está en un índice único parcial a nivel de BD, solo entre
  // filas activas (WHERE eliminadoEn IS NULL, ver migration.sql), para que
  // el soft-delete permita recrear un prefijo sin perder protección contra
  // duplicados concurrentes (FAS-PMQ-R1-006). Desde Fase 2, el índice es
  // (empresaId, modelo) — cada empresa configura su propio prefijo/dígitos.
  empresaId      Int
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  modelo         String
  // Solo aplica para modelo='embarque' (2026-08-13): el prefijo pasa a ser
  // por Tipo de Embarque en vez de único por modelo — el número de
  // instructivo del Embarque se genera como {prefijo}{folio de la NV}, y
  // cada Tipo de Embarque (Marítimo, Aéreo...) necesita el suyo. Para el
  // resto de los modelos queda null (unicidad real por partial index — ver
  // migration.sql: (empresaId, modelo) cuando es null, (empresaId, modelo,
  // tipoEmbarqueId) cuando no lo es — no representable en el DSL de Prisma).
  tipoEmbarqueId Int?
  tipoEmbarque   TipoEmbarque? @relation(fields: [empresaId, tipoEmbarqueId], references: [empresaId, id])
  prefijo        String
  digitos        Int
  creadoEn       DateTime      @default(now())
  creadoPor      String
  actualizadoEn  DateTime?     @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([empresaId])
  @@index([tipoEmbarqueId])
  @@map("prefijos_codigo")
}

