  PENDIENTE
  NOTIFICADA
  // CERRADA queda obsoleto (supersedido 2026-08-14): el cierre ahora exige un
  // veredicto explícito. Se mantiene el valor en el enum de Postgres (no se
  // puede eliminar un valor de enum sin recrear el tipo) pero la aplicación
  // ya no lo escribe — las filas CERRADA existentes se migraron a APROBADA.
  CERRADA
  APROBADA
  RECHAZADA
  // Nuevo veredicto de cierre (2026-08-10) — terminal, mismo tratamiento que
  // RECHAZADA (bloquea OC, no se reabre automáticamente): Compras/Ventas
  // objeta la inspección sin necesariamente rechazarla de plano.
  OBJETADA
}

enum FuncionAsignadoInspeccion {
  ACUDIR
  NOTIFICAR
}

model SolicitudInspeccion {
  id                    Int                       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa                   @relation(fields: [empresaId], references: [id])
  numero                Int // correlativo por temporada
  codigo                String // SI-{codTemporada}-{NNNN}
  temporadaId           Int
  // FK compuesta (empresaId, temporadaId) -> Temporada(empresaId, id): impide
  // a nivel de BD que una SolicitudInspeccion quede en una empresa distinta a
  // la de su Temporada (mismo patrón que Mercado↔GrupoMercado en Fase 2a).
  temporada             Temporada                 @relation(fields: [empresaId, temporadaId], references: [empresaId, id])
  entidadProductorId    Int // Entidad tipo PRODUCTOR
  entidadProductor      Entidad                   @relation("SolicitudInspeccionProductor", fields: [empresaId, entidadProductorId], references: [empresaId, id])
  direccionId           Int // EntidadDireccion de la entidad productora
  direccion             EntidadDireccion          @relation(fields: [direccionId], references: [id])
  contactoId            Int? // EntidadContacto de la entidad productora (opcional)
  contacto              EntidadContacto?          @relation(fields: [contactoId], references: [id])
  especieId             Int?
  especie               Especie?                  @relation(fields: [empresaId, especieId], references: [empresaId, id])
  fechaHora             DateTime // fecha y hora de la visita
  // Documento N° 107 (calidad.md §3) — retomados por decisión de negocio (2026-07-26)
  mercadoId             Int?
  mercado               Mercado?                  @relation(fields: [empresaId, mercadoId], references: [empresaId, id])
  clienteId             Int? // Entidad tipo CLIENTE_EXTRANJERO (opcional)
  cliente               Entidad?                  @relation("SolicitudInspeccionCliente", fields: [empresaId, clienteId], references: [empresaId, id])
  fechaDespacho         DateTime?                 @db.Date
  cantidadPallets       Int?
  calificacionId        Int?
  calificacion          Calificacion?             @relation(fields: [empresaId, calificacionId], references: [empresaId, id])
  observaciones         String?
  // Solicitante de negocio (2026-08-14): distinto de `creadoPor` (auditoría
  // pura, "quién hizo el request"). Por defecto es el usuario de sesión al
  // crear, pero es editable — alguien puede crear la solicitud en nombre de
  // otro. Toda lógica de "quién es el solicitante" (correos, permisos sobre
  // adjuntos) usa este campo, no `creadoPor`.
  usuarioSolicitanteId  String
  usuarioSolicitante    Usuario                   @relation("SolicitudInspeccionSolicitante", fields: [usuarioSolicitanteId], references: [id])
  estado                EstadoSolicitudInspeccion @default(PENDIENTE)
  notificadaEn          DateTime?
  recordatorioEnviadoEn DateTime?
  comentariosCierre     String?
  fechaCierre           DateTime?
  cerradaPor            String? // Usuario
  creadoEn              DateTime                  @default(now())
  creadoPor             String // auditoría — quién ejecutó el alta, no necesariamente el solicitante (ver usuarioSolicitanteId)
  actualizadoEn         DateTime?                 @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  asignados  SolicitudInspeccionAsignado[]
  adjuntos   SolicitudInspeccionAdjunto[]
  paises     SolicitudInspeccionPais[]
  variedades SolicitudInspeccionVariedad[]
  calibres   SolicitudInspeccionCalibre[]
  categorias SolicitudInspeccionCategoria[]
  embalajes  SolicitudInspeccionEmbalaje[]

  ordenesCompra OrdenCompraSolicitudInspeccion[]

  @@unique([temporadaId, numero])
  @@unique([empresaId, id])
  @@index([estado])
  @@index([entidadProductorId])
  @@index([eliminadoEn])
  @@index([empresaId])
  @@map("solicitudes_inspeccion")
}

model SolicitudInspeccionPais {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  paisId      Int
  pais        Pais                @relation(fields: [paisId], references: [id])

  @@unique([solicitudId, paisId])
  @@map("solicitud_inspeccion_paises")
}

model SolicitudInspeccionVariedad {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  variedadId  Int
  variedad    Variedad            @relation(fields: [variedadId], references: [id])

  @@unique([solicitudId, variedadId])
  @@map("solicitud_inspeccion_variedades")
}

model SolicitudInspeccionCalibre {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  calibreId   Int
  calibre     Calibre             @relation(fields: [calibreId], references: [id])

  @@unique([solicitudId, calibreId])
  @@map("solicitud_inspeccion_calibres")
}

model SolicitudInspeccionCategoria {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  categoriaId Int
  categoria   Categoria           @relation(fields: [categoriaId], references: [id])

  @@unique([solicitudId, categoriaId])
  @@map("solicitud_inspeccion_categorias")
}

model SolicitudInspeccionEmbalaje {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  articuloId  Int
  articulo    Articulo            @relation(fields: [articuloId], references: [id])

  @@unique([solicitudId, articuloId])
  @@map("solicitud_inspeccion_embalajes")
}

model Calificacion {
  id                    Int       @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  bloqueado             Boolean   @default(false)
  creadoEn              DateTime  @default(now())
  creadoPor             String
  actualizadoEn         DateTime? @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  solicitudesInspeccion SolicitudInspeccion[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("calificaciones")
}

model SolicitudInspeccionAsignado {
  id          Int                       @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion       @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario                   @relation(fields: [usuarioId], references: [id])
  funcion     FuncionAsignadoInspeccion

  @@unique([solicitudId, usuarioId])
  @@map("solicitud_inspeccion_asignados")
}

// Metadatos del adjunto — el binario vive en tabla aparte para no cargar blobs al listar
model SolicitudInspeccionAdjunto {
  id          Int                 @id @default(autoincrement())
  solicitudId Int
  solicitud   SolicitudInspeccion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  nombre      String
  mime        String
  tamano      Int // bytes
  etapa       String // CREACION | CIERRE
  subidoEn    DateTime            @default(now())
  subidoPor   String // Usuario

  contenido SolicitudInspeccionAdjuntoContenido?

  @@index([solicitudId])
  @@map("solicitud_inspeccion_adjuntos")
}

model SolicitudInspeccionAdjuntoContenido {
  adjuntoId Int                        @id
  adjunto   SolicitudInspeccionAdjunto @relation(fields: [adjuntoId], references: [id], onDelete: Cascade)
  datos     Bytes

  @@map("solicitud_inspeccion_adjuntos_contenido")
}

// ─── Configuración de correo (SMTP) ──────────────────────────────────────────

model ConfiguracionCorreo {
  id              Int       @id @default(autoincrement())
  // Una fila por empresa (Fase 2) — antes era singleton global.
  empresaId       Int       @unique
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  host            String // ej. smtp.office365.com
  puerto          Int       @default(587)
  seguridad       String    @default("STARTTLS") // STARTTLS | SSL | NINGUNA
  usuario         String // casilla que autentica
  passwordCifrada String // AES-256-GCM, nunca se expone por API
  remitenteNombre String
  remitenteEmail  String
  creadoEn        DateTime  @default(now())
  creadoPor       String
  actualizadoEn   DateTime? @updatedAt
  actualizadoPor  String?

  @@map("configuracion_correo")
}

// ─── Materiales — Maestro de artículos, recetas y movimientos ───────────────

enum TipoArticulo {
  EMBALAJE
  ENVASE
  MATERIAL_EMBALAJE
  SERVICIO
}

enum TipoCosteo {
  PROMEDIO_PONDERADO
  ESTANDAR
}

enum ModuloSistema {
  MATERIALES
  FRUTA
}

enum ClaseMovimiento {
  ENTRADA
  SALIDA
  TRASLADO
}

model Articulo {
  id                    Int          @id @default(autoincrement())
  empresaId             Int
  empresa               Empresa      @relation(fields: [empresaId], references: [id])
  tipo                  TipoArticulo
  codigo                String
  descripcion           String
  descripcionExtranjera String?
  unidadId              Int
  // FK compuesta (empresaId, unidadId) -> UnidadMedida(empresaId, id): mismo
  // patrón que Mercado↔GrupoMercado (Fase 2a).
  unidad                UnidadMedida @relation(fields: [empresaId, unidadId], references: [empresaId, id])
  tipoCosteo            TipoCosteo
  valorEstandar         Decimal?     @db.Decimal(14, 4) // requerido si ESTANDAR (R3)
  controlaStock         Boolean      @default(true) // false si ESTANDAR (R3)
  stockCritico          Decimal?     @db.Decimal(14, 3)
  activo                Boolean      @default(true)
  // Atributos físicos del embalaje (Orden de Compra hereda estos valores del
  // artículo elegido en la línea, no los duplica — ver compras.md §4.3).
  etiquetaId            Int?
  // FK compuesta (empresaId, etiquetaId) -> Etiqueta(empresaId, id): mismo
  // patrón que Articulo.unidadId. Requerida solo si tipo = EMBALAJE (validado
  // en articulos.service.ts, no a nivel de columna — mismo criterio que
  // valorEstandar/ESTANDAR).
  etiqueta              Etiqueta?    @relation(fields: [empresaId, etiquetaId], references: [empresaId, id])
  kgNetoEnvase          Decimal?     @db.Decimal(10, 3)
  kgBrutoEnvase         Decimal?     @db.Decimal(10, 3)

  documentos                  DocumentoArticulo[]
  recetas                     Receta[]                      @relation("EmbalajeRecetas")
  comoComponente              RecetaDetalle[]               @relation("ComponenteRecetas")
  saldos                      SaldoArticulo[]
  movimientosDetalle          MovimientoDetalle[]
  notaVentaDetalles           NotaVentaDetalle[]
  instructivoEmbalajeDetalles InstructivoEmbalajeDetalle[]
  ordenCompraLineas           OrdenCompraLinea[]
  contratoProductorLineas     ProductorContratoLinea[]
  solicitudesInspeccion       SolicitudInspeccionEmbalaje[]
  palletLineas                PalletLinea[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@index([tipo])
  @@index([activo])
  @@index([empresaId])
  @@map("articulos")
}

model DocumentoArticulo {
  id         Int      @id @default(autoincrement())
  articuloId Int
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  nombre     String
  mime       String
  tamano     Int
  subidoPor  String
  creadoEn   DateTime @default(now())

  contenido DocumentoArticuloContenido?

  @@index([articuloId])
  @@map("documentos_articulo")
}

// Metadatos separados del binario (mismo patrón que adjuntos de Solicitud de Inspección, SI-2)
model DocumentoArticuloContenido {
  documentoId Int               @id
  documento   DocumentoArticulo @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  datos       Bytes

  @@map("documentos_articulo_contenido")
}

model Receta {
  id                Int      @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  embalajeId        Int // FK a Articulo tipo EMBALAJE (R13)
  // FK compuesta (empresaId, embalajeId) -> Articulo(empresaId, id).
  embalaje          Articulo @relation("EmbalajeRecetas", fields: [empresaId, embalajeId], references: [empresaId, id])
  codigo            String
  descripcion       String
  cantidadAProducir Decimal  @db.Decimal(14, 3)
  activo            Boolean  @default(true)

  detalle RecetaDetalle[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([embalajeId])
  @@index([empresaId])
  @@map("recetas")
}

model RecetaDetalle {
  id                Int      @id @default(autoincrement())
  recetaId          Int
  receta            Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  componenteId      Int // FK a Articulo MATERIAL_EMBALAJE o SERVICIO (R13)
  componente        Articulo @relation("ComponenteRecetas", fields: [componenteId], references: [id])
  cantidadAConsumir Decimal  @db.Decimal(14, 4)

  @@index([recetaId])
  @@map("receta_detalles")
}

model TipoMovimiento {
  id                 Int             @id @default(autoincrement())
  empresaId          Int
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  codigo             String
  descripcion        String
  modulos            ModuloSistema[]
  clase              ClaseMovimiento
  requierePrecio     Boolean         @default(false)
  entidadRelacionada TipoEntidad?
  emiteDTE           Boolean         @default(false)
  activo             Boolean         @default(true)

  movimientos Movimiento[]

  creadoEn DateTime @default(now())

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@index([clase])
  @@index([empresaId])
  @@map("tipos_movimiento")
}

model SaldoArticulo {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  articuloId    Int
  // FK compuesta (empresaId, articuloId) -> Articulo(empresaId, id).
  articulo      Articulo @relation(fields: [empresaId, articuloId], references: [empresaId, id])
  bodegaId      Int
  // FK compuesta (empresaId, bodegaId) -> Bodega(empresaId, id).
  bodega        Bodega   @relation(fields: [empresaId, bodegaId], references: [empresaId, id])
  cantidad      Decimal  @default(0) @db.Decimal(14, 3)
  costoPromedio Decimal  @default(0) @db.Decimal(14, 4)
  actualizadoEn DateTime @updatedAt

  @@unique([articuloId, bodegaId])
  @@index([articuloId])
  @@index([empresaId])
  @@map("saldos_articulo")
}

model Movimiento {
  id               Int            @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  tipoMovimientoId Int
  // FK compuesta (empresaId, tipoMovimientoId) -> TipoMovimiento(empresaId, id).
  tipoMovimiento   TipoMovimiento @relation(fields: [empresaId, tipoMovimientoId], references: [empresaId, id])
  entidadId        Int?
  entidad          Entidad?       @relation("MovEntidad", fields: [empresaId, entidadId], references: [empresaId, id])
  fechaRegistro    DateTime       @default(now())
  fechaMovimiento  DateTime
  bodegaOrigenId   Int?
  bodegaOrigen     Bodega?        @relation("MovOrigen", fields: [empresaId, bodegaOrigenId], references: [empresaId, id])
  bodegaDestinoId  Int?
  bodegaDestino    Bodega?        @relation("MovDestino", fields: [empresaId, bodegaDestinoId], references: [empresaId, id])
  guiaReferencia   String?

  // Datos de transporte — requeridos si tipoMovimiento.emiteDTE = true (R10)
  transporteEntidadId Int?
  transporteEntidad   Entidad?  @relation("MovTransporte", fields: [empresaId, transporteEntidadId], references: [empresaId, id])
  choferRut           String?
  choferNombre        String?
  placaCamion         String?
  placaRemolque       String?
  horaSalida          DateTime?
  horaEstimadaLlegada DateTime?

  detalle   MovimientoDetalle[]
  usuarioId String
  creadoEn  DateTime            @default(now())

  @@index([tipoMovimientoId])
  @@index([fechaMovimiento])
  @@index([empresaId])
  @@map("movimientos")
}

model MovimientoDetalle {
  id             Int        @id @default(autoincrement())
  movimientoId   Int
  movimiento     Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  articuloId     Int
  articulo       Articulo   @relation(fields: [articuloId], references: [id])
  cantidad       Decimal    @db.Decimal(14, 3)
  precioUnitario Decimal?   @db.Decimal(14, 4)

  @@index([movimientoId])
  @@index([articuloId])
  @@map("movimiento_detalles")
}

// ─── Productores — Predios, Contrato, Cuenta Corriente, Conceptos de Liquidación ─

enum NaturalezaMovimientoCC {
  DEBE
  HABER
}

enum FormaAplicacionConcepto {
  POR_KILO
  POR_CAJA
  PORCENTAJE_VENTA
  MONTO_TOTAL
}

enum NaturalezaConcepto {
  COBRO
  ABONO
}

model Predio {
  id               Int             @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa         @relation(fields: [empresaId], references: [id])
  entidadId        Int // Entidad tipo PRODUCTOR (R1)
  // FK compuesta (empresaId, entidadId) -> Entidad(empresaId, id).
  entidad          Entidad         @relation("PrediosProductor", fields: [empresaId, entidadId], references: [empresaId, id])
  codigo           String // único por productor (R2, índice parcial)
  descripcion      String
  codigoCsg        String?
  nombreCsg        String?
  codigoSdp        String?
  codigoGgn        String?
  direccion        String?
  comunaId         Int?
  comuna           Comuna?         @relation(fields: [comunaId], references: [id])
  tipoProduccionId Int?
  // FK compuesta (empresaId, tipoProduccionId) -> TipoProduccion(empresaId, id).
  tipoProduccion   TipoProduccion? @relation(fields: [empresaId, tipoProduccionId], references: [empresaId, id])
  zonaId           Int?
  zona             Zona?           @relation(fields: [zonaId], references: [id])
  latitud          Decimal?        @db.Decimal(10, 7)
  longitud         Decimal?        @db.Decimal(10, 7)

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([entidadId])
  @@index([empresaId])
  @@map("predios")
}

model ProductorContrato {
  id              Int            @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa        @relation(fields: [empresaId], references: [id])
  entidadId       Int
  // FK compuesta (empresaId, entidadId) -> Entidad(empresaId, id).
  entidad         Entidad        @relation("ContratosProductor", fields: [empresaId, entidadId], references: [empresaId, id])
  temporadaId     Int
  // FK compuesta (empresaId, temporadaId) -> Temporada(empresaId, id).
  temporada       Temporada      @relation(fields: [empresaId, temporadaId], references: [empresaId, id])
  especieId       Int
  // FK compuesta (empresaId, especieId) -> Especie(empresaId, id).
  especie         Especie        @relation(fields: [empresaId, especieId], references: [empresaId, id])
  fechaInicio     DateTime       @db.Date
  fechaTermino    DateTime       @db.Date
  // Mantenedor real CondicionPago (tipo COMPRA) — decisión de negocio,
  // Christian, 2026-07-30. Reemplaza el hack anterior de Parametro suelto
  // (que nunca llegó a tener catálogo real). CondicionPago pasa a ser tenant
  // en Fase 3 lote Compras — FK compuesta (empresaId, condicionPagoId) ->
  // CondicionPago(empresaId, id).
  condicionPagoId Int?
  condicionPago   CondicionPago? @relation(fields: [empresaId, condicionPagoId], references: [empresaId, id])
  // Usuario responsable (mismo patrón que OrdenCompra.responsableId,
  // filtrado por esResponsableVenta).
  responsableId   String?
  responsable     Usuario?       @relation(fields: [responsableId], references: [id])

  lineas   ProductorContratoLinea[]
  adjuntos ProductorContratoAdjunto[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([entidadId])
  @@index([especieId])
  @@index([temporadaId])
  @@index([responsableId])
  @@index([empresaId])
  @@map("productor_contratos")
}

// Grilla de características de la fruta comprometidas en el contrato
model ProductorContratoLinea {
  id         Int               @id @default(autoincrement())
  contratoId Int
  contrato   ProductorContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  articuloId     Int // FK → Artículo tipo EMBALAJE
  articulo       Articulo     @relation(fields: [articuloId], references: [id])
  variedadId     Int
  variedad       Variedad     @relation(fields: [variedadId], references: [id])
  calibreDesdeId Int
  calibreDesde   Calibre      @relation("ProductorContratoCalibreDesde", fields: [calibreDesdeId], references: [id])
  calibreHastaId Int
  calibreHasta   Calibre      @relation("ProductorContratoCalibreHasta", fields: [calibreHastaId], references: [id])
  categoriaId    Int
  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  unidadMedidaId Int
  unidadMedida   UnidadMedida @relation(fields: [unidadMedidaId], references: [id])

  cantidadComprometida Decimal @db.Decimal(14, 3)
  minimoGarantizado    Decimal @db.Decimal(14, 4)

  @@index([contratoId])
  @@map("productor_contrato_linea")
}

// Metadatos del adjunto — el binario vive en tabla aparte (mismo patrón que
// adjuntos de Solicitud de Inspección)
model ProductorContratoAdjunto {
  id         Int               @id @default(autoincrement())
  contratoId Int
  contrato   ProductorContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  nombre     String
  mime       String
  tamano     Int
  subidoEn   DateTime          @default(now())
  subidoPor  String

  contenido ProductorContratoAdjuntoContenido?

  @@index([contratoId])
  @@map("productor_contrato_adjuntos")
}

model ProductorContratoAdjuntoContenido {
  adjuntoId Int                      @id
  adjunto   ProductorContratoAdjunto @relation(fields: [adjuntoId], references: [id], onDelete: Cascade)
  datos     Bytes

  @@map("productor_contrato_adjuntos_contenido")
}

model MovimientoCuentaCorriente {
  id          Int                    @id @default(autoincrement()) // operativo, inmutable (R5)
  empresaId   Int
  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  entidadId   Int // productor
  // FK compuesta (empresaId, entidadId) -> Entidad(empresaId, id).
  entidad     Entidad                @relation("CCProductor", fields: [empresaId, entidadId], references: [empresaId, id])
  tipoId      Int
  // FK compuesta (empresaId, tipoId) -> ConceptoCtaCte(empresaId, id).
  tipo        ConceptoCtaCte         @relation(fields: [empresaId, tipoId], references: [empresaId, id])
  naturaleza  NaturalezaMovimientoCC // DEBE o HABER (consistente con tipo.naturaleza, R6)
  fecha       DateTime
  glosa       String?
  monto       Decimal                @db.Decimal(14, 4)
  monedaId    Int?
  moneda      Moneda?                @relation(fields: [monedaId], references: [id])
  referencia  String?
  temporadaId Int?
  usuarioId   String
  creadoEn    DateTime               @default(now())

  @@index([entidadId, fecha])
  @@index([tipoId])
  @@index([empresaId])
  @@map("movimientos_cuenta_corriente")
}

model ConceptoLiquidacion {
  id              Int                          @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa                      @relation(fields: [empresaId], references: [id])
  codigo          String
  descripcion     String
  formaAplicacion FormaAplicacionConcepto
  naturaleza      NaturalezaConcepto // COBRO (−) / ABONO (+)
  valores         ConceptoLiquidacionEspecie[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([empresaId])
  @@map("conceptos_liquidacion")
}

model ConceptoLiquidacionEspecie {
  id         Int                 @id @default(autoincrement())
  conceptoId Int
  concepto   ConceptoLiquidacion @relation(fields: [conceptoId], references: [id], onDelete: Cascade)
  especieId  Int
  especie    Especie             @relation(fields: [especieId], references: [id])
  valor      Decimal             @db.Decimal(14, 4) // valor del concepto para esa especie

  @@unique([conceptoId, especieId])
  @@index([conceptoId])
  @@map("conceptos_liquidacion_especie")
}

// ─── Ventas — Nota de Venta (Docs/ventas.md §4.1) ────────────────────────────
// Alcance mínimo viable: solo el encabezado + detalle de fruta comprometida.
// Embarque/Instructivo de Embarque y Solicitud de Reserva (§4.2/§4.3) quedan
// diferidos — no están implementados todavía.

model NotaVenta {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  folio     Int // correlativo autonumérico (R1), único por empresa
  fecha     DateTime

  clienteId           Int
  // FK compuesta (empresaId, clienteId) -> Entidad(empresaId, id).
  cliente             Entidad          @relation("NotaVentaCliente", fields: [empresaId, clienteId], references: [empresaId, id])
  // Comprador es un Contacto de la Entidad Cliente (no una Entidad completa) —
  // decisión de negocio, Christian, 2026-07-30.
  compradorContactoId Int?
  compradorContacto   EntidadContacto? @relation(fields: [compradorContactoId], references: [id])
  notifyId            Int?
  notify              Entidad?         @relation("NotaVentaNotify", fields: [empresaId, notifyId], references: [empresaId, id])
  // Supersesión (2026-08-13): antes "Cliente Final" (clienteFinalId) — el
  // rol de Entidad correcto para este campo ya existía como CONSIGNATARIO
  // (TipoEntidad) y nunca se usaba; se renombra para que coincidan.
  consignatarioId     Int?
  consignatario       Entidad?         @relation("NotaVentaConsignatario", fields: [empresaId, consignatarioId], references: [empresaId, id])

  tipoEmbarqueId   Int
  tipoEmbarque     TipoEmbarque      @relation(fields: [empresaId, tipoEmbarqueId], references: [empresaId, id])
  mercadoId        Int
  mercado          Mercado           @relation(fields: [empresaId, mercadoId], references: [empresaId, id])
  paisDestinoId    Int
  paisDestino      Pais              @relation(fields: [paisDestinoId], references: [id])
  puertoDestinoId  Int?
  puertoDestino    Puerto?           @relation(fields: [empresaId, puertoDestinoId], references: [empresaId, id])
  direccionId      Int?
  direccion        EntidadDireccion? @relation(fields: [direccionId], references: [id])
  direccionDetalle String?

  // Modalidad Venta / Cláusula Venta (Incoterm) / Tipo Flete: catálogo
  // genérico Parametro (mantenedores-generales.md), cada uno filtrado por su
  // propio TipoParametro (ver seed).
  modalidadVentaId Int?
  modalidadVenta   Parametro? @relation("NotaVentaModalidadVenta", fields: [empresaId, modalidadVentaId], references: [empresaId, id])
  clausulaVentaId  Int?
  clausulaVenta    Parametro? @relation("NotaVentaClausulaVenta", fields: [empresaId, clausulaVentaId], references: [empresaId, id])
  tipoFleteId      Int?
  tipoFlete        Parametro? @relation("NotaVentaTipoFlete", fields: [empresaId, tipoFleteId], references: [empresaId, id])

  // Forma de pago: condición de pago con cuotas (% + plazo en días), mismo
  // modelo que Compras (CondicionPago). No existe un campo de "saldo pago"
  // separado — las cuotas se snapshotean en NotaVentaCuotaPago al guardar
  // (mismo patrón que OrdenCompraCuotaPago, ver Docs/ventas.md R12).
  // CondicionPago pasa a ser tenant en Fase 3 lote Compras — FK compuesta.
  condicionPagoId Int?
  condicionPago   CondicionPago?       @relation(fields: [empresaId, condicionPagoId], references: [empresaId, id])
  cuotasPago      NotaVentaCuotaPago[]

  monedaId Int
  moneda   Moneda @relation(fields: [monedaId], references: [id])

  observaciones String?

  detalles      NotaVentaDetalle[]
  ordenesCompra OrdenCompra[]
  embarques     Embarque[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([empresaId, id])
  @@index([clienteId])
  @@index([fecha])
  @@index([condicionPagoId])
  @@index([empresaId])
  @@map("notas_venta")
}

// Snapshot inmutable de las cuotas al momento de crear/editar el Cierre
// Comercial (se copian desde CondicionPago.cuotas en el instante en que se
// fija condicionPagoId; si la plantilla cambia después, no afecta Cierres ya
// creados) — mismo patrón que OrdenCompraCuotaPago (compras.md §4.2.1).
model NotaVentaCuotaPago {
  id          Int       @id @default(autoincrement())
  notaVentaId Int
  notaVenta   NotaVenta @relation(fields: [notaVentaId], references: [id], onDelete: Cascade)

  fechaReferencia FechaReferenciaPago @default(FACTURA)
  plazoDias       Int
  tipoValor       TipoValorCuota      @default(PORCENTAJE)
  porcentaje      Decimal?            @db.Decimal(5, 2)
  valorUnitario   Decimal?            @db.Decimal(14, 4)
  monedaId        Int?
  moneda          Moneda?             @relation(fields: [monedaId], references: [id])
  unidadId        Int?
  unidad          UnidadMedida?       @relation(fields: [unidadId], references: [id])
  // Monto ya resuelto (valorUnitario × cantidad real del Cierre Comercial) al
  // momento de snapshotear — inmutable, no se recalcula si cambian las líneas.
  montoCalculado  Decimal?            @db.Decimal(14, 4)
  descripcion     String?

  @@index([notaVentaId])
  @@map("nota_venta_cuota_pago")
}

model NotaVentaDetalle {
  id          Int       @id @default(autoincrement())
  notaVentaId Int
  notaVenta   NotaVenta @relation(fields: [notaVentaId], references: [id], onDelete: Cascade)

  fechaCompromiso DateTime
  especieId       Int
  especie         Especie     @relation(fields: [especieId], references: [id])
  variedadId      Int
  variedad        Variedad    @relation(fields: [variedadId], references: [id])
  articuloId      Int
  articulo        Articulo    @relation(fields: [articuloId], references: [id])
  categoriaId     Int?
  categoria       Categoria?  @relation(fields: [categoriaId], references: [id])
  tipoPalletId    Int?
  tipoPallet      TipoPallet? @relation(fields: [tipoPalletId], references: [id])

  cantidadPallets Int
  cajasPorPallet  Int
  cajas           Int
  precio          Decimal @db.Decimal(14, 4) // valor unitario por caja, en la moneda del encabezado

  // Multiselect de calibres aceptados (antes: rango calibreInicioId/calibreFinId).
  calibres NotaVentaDetalleCalibre[]

  // Líneas de Orden de Compra tomadas (completas o parciales) desde esta
  // línea del Cierre — 2026-08-23, ver OrdenCompraLinea.notaVentaDetalleId.
  ordenCompraLineas OrdenCompraLinea[]

  @@index([notaVentaId])
  @@map("notas_venta_detalle")
}

model NotaVentaDetalleCalibre {
  id                 Int              @id @default(autoincrement())
  notaVentaDetalleId Int
  notaVentaDetalle   NotaVentaDetalle @relation(fields: [notaVentaDetalleId], references: [id], onDelete: Cascade)
  calibreId          Int
  calibre            Calibre          @relation(fields: [calibreId], references: [id])

  @@unique([notaVentaDetalleId, calibreId])
  @@map("notas_venta_detalle_calibre")
}

// ─── Ventas — Embarque (Docs/ventas.md §4.2) ────────────────────────────────
// Versión mínima: solo el encabezado ancla (Folio = numeroInstructivo, R10),
// para soportar la acción "Generar Embarque" desde el Cierre Comercial y el
// workflow de pestañas (aún sin funcionalidad). Las tablas hijas del spec
// (EmbarqueContenedor, AsignacionContenedor, InstructivoHijo,
// SolicitudReserva) se agregan cuando se implemente cada pestaña.
model Embarque {
  id          Int       @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  notaVentaId Int
  // FK compuesta (empresaId, notaVentaId) -> NotaVenta(empresaId, id).
  notaVenta   NotaVenta @relation(fields: [empresaId, notaVentaId], references: [empresaId, id])

  // Q1 resuelta en Docs/ventas.md: Folio = Número de Instructivo (mismo dato,
  // manual, único por empresa). Identidad del instructivo padre.
  numeroInstructivo String

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@index([notaVentaId])
  @@index([empresaId])
  @@map("embarques")
}

// ─── Compras — Instructivo de Embalaje (Docs/compras.md §4.1) ───────────────
// Documento que instruye qué embalar. Sin FK a OrdenCompra (relación
// inexistente por diseño, ver compras.md §6.1). Editable/eliminable (soft
// delete) solo mientras su Inspección de Proceso no tenga veredicto — ver
// InspeccionProcesoEstado abajo (supersede el "sin máquina de estados"
// original, 2026-08-21).

// Ciclo de vida de la Inspección de Proceso (2026-08-21): el Instructivo de
// Embalaje ES la inspección de proceso para Calidad. Flujo:
// PENDIENTE → NOTIFICADA → APROBADA → CERRADA, con RECHAZADA terminal.
// Los folios (números de pallet) solo se cargan en APROBADA (calidad.md §4).
enum InspeccionProcesoEstado {
  PENDIENTE
  NOTIFICADA
  APROBADA
  RECHAZADA
  CERRADA
}

// Estado de cada folio aprobado. Al recepcionarlo (Recepción de Proceso,
// Etapa 3) pasa a RECEPCIONADO y queda bloqueado para borrado.
enum EstadoFolioInspeccion {
  APROBADO
  RECEPCIONADO
}

model InstructivoEmbalaje {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  numero    Int // correlativo propio, único por empresa

  // Supersesión (2026-08-12): reemplaza notaVentaId — el instructivo ocurre
  // antes de que exista un Cierre Comercial asociado (compras.md §5.1/§5.2,
  // el flujo real nunca lo ató a una NV), así que se ancla al productor en
  // vez de a la venta.
  entidadProductorId  Int
  entidadProductor    Entidad      @relation("InstructivoEmbalajeProductor", fields: [empresaId, entidadProductorId], references: [empresaId, id])
  grupoMercadoId      Int
  grupoMercado        GrupoMercado @relation(fields: [empresaId, grupoMercadoId], references: [empresaId, id])
  fechaInicioPrograma DateTime
  observaciones       String?

  // Inspección de Proceso (2026-08-21) — el instructivo es también la
  // inspección de proceso que gestiona Calidad (CAL_SOLICITUDES).
  estadoInspeccion     InspeccionProcesoEstado @default(PENDIENTE)
  notificadaEn         DateTime?
  comentarioInspeccion String?
  inspeccionadoEn      DateTime? // fecha del veredicto (aprobar/rechazar)
  inspeccionadoPor     String? // Usuario que emitió el veredicto

  detalle InstructivoEmbalajeDetalle[]
  folios  InstructivoEmbalajeFolio[]

  creadoEn     DateTime  @default(now())
  creadoPor    String
  eliminadoEn  DateTime?
  eliminadoPor String?

  @@unique([empresaId, id])
  @@index([entidadProductorId])
  @@index([grupoMercadoId])
  @@index([empresaId])
  @@map("instructivos_embalaje")
}

// Folios (= números de pallet) aprobados por Calidad para una Inspección de
// Proceso. Únicos por empresa en TODO el sistema (SQ2, 2026-08-21) — impide
// aprobar el mismo pallet en dos instructivos. La Recepción de Proceso (Etapa
// 3) los marca RECEPCIONADO y enlaza el Pallet resultante (palletId).
model InstructivoEmbalajeFolio {
  id            Int                   @id @default(autoincrement())
  empresaId     Int
  instructivoId Int
  // FK compuesta (empresaId, instructivoId) -> InstructivoEmbalaje(empresaId, id):
  // garantiza a nivel de BD que el folio viva en la misma empresa que su
  // instructivo (mismo patrón tenant que el resto del schema).
  instructivo   InstructivoEmbalaje   @relation(fields: [empresaId, instructivoId], references: [empresaId, id], onDelete: Cascade)
  folio         String
  estado        EstadoFolioInspeccion @default(APROBADO)
  palletId      Int? // se completa en Recepción de Proceso (Etapa 3)
  creadoEn      DateTime              @default(now())
  creadoPor     String

  @@unique([empresaId, folio]) // folio único por empresa (aprobación)
  @@unique([empresaId, id])
  @@index([empresaId])
  @@index([instructivoId])
  @@map("instructivo_embalaje_folios")
}

model InstructivoEmbalajeDetalle {
  id            Int                 @id @default(autoincrement())
  instructivoId Int
  instructivo   InstructivoEmbalaje @relation(fields: [instructivoId], references: [id], onDelete: Cascade)

  articuloId         Int // FK → Artículo tipo EMBALAJE
  articulo           Articulo    @relation(fields: [articuloId], references: [id])
  especieId          Int
  especie            Especie     @relation(fields: [especieId], references: [id])
  variedadId         Int
  variedad           Variedad    @relation("InstructivoEmbalajeDetalleVariedad", fields: [variedadId], references: [id])
  // Segunda variedad opcional, de la misma especie (2026-08-12).
  variedadRotuladaId Int?
  variedadRotulada   Variedad?   @relation("InstructivoEmbalajeDetalleVariedadRotulada", fields: [variedadRotuladaId], references: [id])
  categoriaId        Int
  categoria          Categoria   @relation(fields: [categoriaId], references: [id])
  tipoPalletId       Int?
  tipoPallet         TipoPallet? @relation(fields: [tipoPalletId], references: [id])
  alturaId           Int
  altura             Altura      @relation(fields: [alturaId], references: [id])

  cantidadPallets Int
  cajasPorPallet  Int
  cajas           Int

  // Multiselect de calibres (antes: rango calibreMinId/calibreMaxId — ver
  // supersesión 2026-08-15, mismo patrón que NotaVentaDetalleCalibre).
  calibres InstructivoEmbalajeDetalleCalibre[]

  @@index([instructivoId])
  @@index([variedadRotuladaId])
  @@index([alturaId])
  @@map("instructivo_embalaje_detalle")
}

model InstructivoEmbalajeDetalleCalibre {
  // Nombres de columna cortos a propósito: el nombre de tabla ya es largo y
  // Postgres trunca identificadores a 63 bytes (índices/constraints
  // generados por Prisma con el nombre completo del campo lo superarían).
  id        Int                        @id @default(autoincrement())
  detalleId Int
  detalle   InstructivoEmbalajeDetalle @relation(fields: [detalleId], references: [id], onDelete: Cascade)
  calibreId Int
  calibre   Calibre                    @relation(fields: [calibreId], references: [id])

  @@unique([detalleId, calibreId])
  @@map("instructivo_embalaje_detalle_calibre")
}

// ─── Compras — Orden de Compra (Docs/compras.md §4.2/§4.3) ──────────────────
// Alcance mínimo acordado con el usuario: sin informeCalidadId (no se exige
// Calidad aprobada todavía) y con campos comerciales que el documento real de
// Agrosan usa y que el spec original no cubría (proveedor, forma/plazos de
// pago, incoterm, facturar a).

enum EstadoOrdenCompra {
  BORRADOR
  EMITIDA
  RECEPCIONADA
}

model OrdenCompra {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  numero    String // OC-{AAAA}-{NNNN}, correlativo por año, único por empresa

  entidadProductorId    Int // Entidad tipo PRODUCTOR
  // FK compuesta (empresaId, entidadProductorId) -> Entidad(empresaId, id).
  entidadProductor      Entidad              @relation("OrdenCompraProductor", fields: [empresaId, entidadProductorId], references: [empresaId, id])
  notaVentaId           Int? // origen Cierre Comercial; null = Manual
  notaVenta             NotaVenta?           @relation(fields: [empresaId, notaVentaId], references: [empresaId, id])
  // Inspecciones de Compra que habilitan la OC (2026-08-14, reinstala la
  // trazabilidad Compras↔Calidad diferida en el spec original — ver
  // compras.md §4.2). Requeridas solo a nivel de aplicación (no de columna,
  // por si existen OCs de desarrollo previas a este cambio): al menos una
  // debe tener estado=APROBADA, y TODAS deben tener el mismo
  // entidadProductorId que la OC. N:M vía OrdenCompraSolicitudInspeccion
  // (2026-08-21, Etapa 2 — supersede el solicitudInspeccionId singular:
  // una Solicitud solo puede estar en una OC, pero una OC puede tener
  // varias Solicitudes).
  solicitudes OrdenCompraSolicitudInspeccion[]

  fecha DateTime @default(now())

  formaPagoId      Int?
  formaPago        FormaPago?        @relation(fields: [empresaId, formaPagoId], references: [empresaId, id])
  condicionPagoId  Int?
  condicionPago    CondicionPago?    @relation(fields: [empresaId, condicionPagoId], references: [empresaId, id])
  monedaId         Int
  moneda           Moneda            @relation(fields: [monedaId], references: [id])
  destinoMercadoId Int?
  destinoMercado   Mercado?          @relation(fields: [empresaId, destinoMercadoId], references: [empresaId, id])
  responsableId    String?
  responsable      Usuario?          @relation(fields: [responsableId], references: [id])
  // Incoterm (2026-08-12) — reintroducido: catálogo genérico Parametro
  // (TipoParametro codigo=INCOTERM, mismo mecanismo ya usado por
  // NotaVenta.clausulaVentaId). Reemplaza el incotermId eliminado el
  // 2026-08-07 por falta de catálogo — el catálogo ya existe.
  incotermId       Int?
  incoterm         Parametro?        @relation("OrdenCompraIncoterm", fields: [empresaId, incotermId], references: [empresaId, id])
  observaciones    String?
  estado           EstadoOrdenCompra @default(BORRADOR)

  lineas      OrdenCompraLinea[]
  cuotasPago  OrdenCompraCuotaPago[]
  // Array porque Prisma exige @unique en la FK para modelar 1:1, pero la
  // unicidad real es solo entre Recepciones activas (índice parcial WHERE
  // eliminadoEn IS NULL) — filas soft-deleted pueden repetir ordenCompraId.
  // En la práctica una OC tiene a lo más una Recepcion ACTIVA a la vez
  // (recepciones.repository.ts getRecepcionActivaPorOrdenCompra).
  recepciones Recepcion[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([empresaId, id])
  @@index([entidadProductorId])
  @@index([notaVentaId])
  @@index([formaPagoId])
  @@index([condicionPagoId])
  @@index([destinoMercadoId])
  @@index([responsableId])
  @@index([empresaId])
  @@map("ordenes_compra")
}

// Vínculo OC↔Solicitud de Inspección (2026-08-21, Etapa 2 — supersede el
// solicitudInspeccionId singular en OrdenCompra, ver compras.md §4.2). Una OC
// puede tener varias Solicitudes; el @@unique de solicitudInspeccionId impone
// que cada Solicitud pertenezca como máximo a una OC (misma tabla soportaría
// N:M verdadero si esa restricción se relaja más adelante).
model OrdenCompraSolicitudInspeccion {
  id        Int @id @default(autoincrement())
  empresaId Int

  ordenCompraId Int
  ordenCompra   OrdenCompra @relation(fields: [empresaId, ordenCompraId], references: [empresaId, id], onDelete: Cascade)

  solicitudInspeccionId Int
  solicitudInspeccion   SolicitudInspeccion @relation(fields: [empresaId, solicitudInspeccionId], references: [empresaId, id])

  creadoEn  DateTime @default(now())
  creadoPor String

  @@unique([empresaId, solicitudInspeccionId])
  @@index([empresaId])
  @@index([ordenCompraId])
  // Nombre de tabla acortado a propósito: "orden_compra_solicitudes_
  // inspeccion" generaba nombres de constraint FK/índice de más de 63 bytes
  // (límite de identificador de Postgres) — ver migración.
  @@map("oc_solicitudes_inspeccion")
}

// COMPRA: usada en Órdenes de Compra (pago a productor). VENTA: usada en
// Cierre Comercial / Notas de Venta (cobro a cliente). Exclusivo — son flujos
// de caja distintos y no se comparten condiciones entre ambos.
enum TipoCondicionPago {
  COMPRA
  VENTA
}

// Maestro: cabecera + cuotas (mismo patrón cabecera+matriz que ConceptoLiquidacion).
// Determina automáticamente las cuotas de pago de la Orden de Compra al
// seleccionarse — no se cargan manualmente por OC.
model CondicionPago {
  id          Int               @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa           @relation(fields: [empresaId], references: [id])
  codigo      String
  descripcion String
  tipo        TipoCondicionPago
  bloqueado   Boolean           @default(false)

  cuotas             CondicionPagoCuota[]
  ordenesCompra      OrdenCompra[]
  notasVenta         NotaVenta[]
  contratosProductor ProductorContrato[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([empresaId, id])
  @@index([empresaId])
  @@map("condiciones_pago")
}

// Fechas desde las que se cuenta el plazo en días de una cuota (R12b).
enum FechaReferenciaPago {
  FACTURA
  ZARPE
  ENVIO_DOCUMENTOS
}

// PORCENTAJE: cuota expresada como % (deben sumar 100% entre las cuotas
// PORCENTAJE de una misma condición). MONTO_UNITARIO: solo permitido en la
// primera cuota — valor fijo por unidad (caja o kilo) en una moneda, que se
// multiplica por la cantidad real de la OC/Cierre Comercial al aplicarse.
enum TipoValorCuota {
  PORCENTAJE
  MONTO_UNITARIO
}

model CondicionPagoCuota {
  id              Int           @id @default(autoincrement())
  condicionPagoId Int
  condicionPago   CondicionPago @relation(fields: [condicionPagoId], references: [id], onDelete: Cascade)

  fechaReferencia FechaReferenciaPago @default(FACTURA)
  plazoDias       Int
  tipoValor       TipoValorCuota      @default(PORCENTAJE)
  porcentaje      Decimal?            @db.Decimal(5, 2)
  valorUnitario   Decimal?            @db.Decimal(14, 4)
  monedaId        Int?
  moneda          Moneda?             @relation(fields: [monedaId], references: [id])
  unidadId        Int?
  unidad          UnidadMedida?       @relation(fields: [unidadId], references: [id])
  descripcion     String?

  @@index([condicionPagoId])
  @@map("condicion_pago_cuota")
}

model OrdenCompraCuotaPago {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  fechaReferencia FechaReferenciaPago @default(FACTURA)
  plazoDias       Int
  tipoValor       TipoValorCuota      @default(PORCENTAJE)
  porcentaje      Decimal?            @db.Decimal(5, 2)
  valorUnitario   Decimal?            @db.Decimal(14, 4)
  monedaId        Int?
  moneda          Moneda?             @relation(fields: [monedaId], references: [id])
  unidadId        Int?
  unidad          UnidadMedida?       @relation(fields: [unidadId], references: [id])
  // Monto ya resuelto (valorUnitario × cantidad real de la OC) al momento de
  // snapshotear — inmutable, no se recalcula si cambian las líneas después.
  montoCalculado  Decimal?            @db.Decimal(14, 4)
  descripcion     String?

  @@index([ordenCompraId])
  @@map("orden_compra_cuota_pago")
}

model OrdenCompraLinea {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  especieId    Int
  especie      Especie     @relation(fields: [especieId], references: [id])
  variedadId   Int
  variedad     Variedad    @relation(fields: [variedadId], references: [id])
  categoriaId  Int
  categoria    Categoria   @relation(fields: [categoriaId], references: [id])
  articuloId   Int // FK → Artículo tipo EMBALAJE (etiqueta/pesos se leen del artículo)
  articulo     Articulo    @relation(fields: [articuloId], references: [id])
  tipoPalletId Int?
  tipoPallet   TipoPallet? @relation(fields: [tipoPalletId], references: [id])

  cantidadPallets Int
  cajasPorPallet  Int
  cajas           Int
  precioUsdCaja   Decimal @db.Decimal(14, 4)

  // Multiselect de calibres (antes: rango calibreMinId/calibreMaxId — ver
  // supersesión 2026-08-15, mismo patrón que NotaVentaDetalleCalibre).
  calibres OrdenCompraLineaCalibre[]

  // Origen opcional: línea tomada (completa o parcial) de una línea del
  // Cierre Comercial de la propia OC (2026-08-23). Bloquea
  // especie/variedad/categoría/artículo/tipoPallet (se copian server-side
  // desde la línea del Cierre, nunca desde el cliente) y exige que los
  // calibres sean subconjunto de los de esa línea; `cajas` queda limitado al
  // disponible (cajas de la línea del Cierre menos lo ya comprometido por
  // otras OrdenCompraLinea vigentes con el mismo origen). Sin unicidad: una
  // línea del Cierre puede repartirse entre varias OrdenCompraLinea, incluso
  // de la misma OC (decisión de negocio, Christian). onDelete Restrict:
  // eliminar la línea del Cierre se bloquea a nivel de aplicación
  // (notas-venta.service.ts) mientras tenga cajas comprometidas — esta FK es
  // la defensa de última instancia.
  notaVentaDetalleId Int?
  notaVentaDetalle   NotaVentaDetalle? @relation(fields: [notaVentaDetalleId], references: [id], onDelete: Restrict)

  @@index([ordenCompraId])
  @@index([notaVentaDetalleId])
  @@map("orden_compra_linea")
}

model OrdenCompraLineaCalibre {
  id                 Int              @id @default(autoincrement())
  ordenCompraLineaId Int
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [ordenCompraLineaId], references: [id], onDelete: Cascade)
  calibreId          Int
  calibre            Calibre          @relation(fields: [calibreId], references: [id])

  @@unique([ordenCompraLineaId, calibreId])
  @@map("orden_compra_linea_calibre")
}

// ─── RECEPCIÓN DE STOCK (compras.md §4.4-4.7) ─────────────────────────────────

enum OrigenRecepcion {
  COMPRA
  CONSIGNACION
  // Fruta de proceso (2026-08-23, Etapa 3): sin OC, como CONSIGNACION, pero
  // cada N° de Pallet del Excel debe corresponder a un
  // InstructivoEmbalajeFolio APROBADO — que al insertarse pasa a
  // RECEPCIONADO con su palletId (compras.md §7, calidad.md).
  PROCESO
}

enum EstadoRecepcion {
  CARGADA // archivo subido sin procesar todavía; también el estado final de una carga libre en consignación que ya generó pallets (compras.md §8 — no existe transición propia para ese modo)
  VALIDADA // cuadró contra la OC (modo compra) y generó pallets
  RECHAZADA // no cuadró contra la OC — no genera pallets
}

model Recepcion {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  numero    String // RC-{AAAA}-{NNNN}, correlativo por año (mismo patrón que OrdenCompra), único por empresa

  // Sin @unique de Prisma (no soporta índices parciales en el DSL): la
  // unicidad real es un índice único parcial a nivel de BD, solo entre filas
  // activas (WHERE eliminadoEn IS NULL, ver migration.sql) — permite que al
  // eliminar (soft-delete) una Recepción CARGADA la OC quede libre para una
  // Recepción nueva (QAR-RCT-004), sin perder protección contra duplicados
  // concurrentes.
  ordenCompraId Int? // nullable = modo CONSIGNACION
  // FK compuesta (empresaId, ordenCompraId) -> OrdenCompra(empresaId, id).
  ordenCompra   OrdenCompra?    @relation(fields: [empresaId, ordenCompraId], references: [empresaId, id])
  // Derivado server-side de ordenCompraId (no se acepta como input) — se
  // propaga a todos los pallets generados por esta Recepción (compras.md §4.4).
  origen        OrigenRecepcion

  plantaId          Int // Entidad tipo PLANTA (compras.md: "Planta" no es mantenedor propio, es Entidad con tipos incluyendo PLANTA)
  // FK compuesta (empresaId, plantaId) -> Entidad(empresaId, id).
  planta            Entidad          @relation("RecepcionPlanta", fields: [empresaId, plantaId], references: [empresaId, id])
  direccionPlantaId Int // EntidadDireccion — debe pertenecer a plantaId
  direccionPlanta   EntidadDireccion @relation(fields: [direccionPlantaId], references: [id])

  // Mapeo de columnas del Excel a aplicar (config.md templates-carga) — opcional
  // en esta etapa estructural; requerido cuando se implemente el parseo real.
  templateCargaId Int?
  // FK compuesta (empresaId, templateCargaId) -> TemplateCarga(empresaId, id).
  templateCarga   TemplateCarga? @relation(fields: [empresaId, templateCargaId], references: [empresaId, id])

  estado        EstadoRecepcion @default(CARGADA)
  observaciones String?

  adjuntos RecepcionAdjunto[]
  pallets  Pallet[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([empresaId, id])
  @@index([plantaId])
  @@index([templateCargaId])
  @@index([eliminadoEn])
  @@index([empresaId])
  @@map("recepciones")
}

model RecepcionAdjunto {
  id          Int       @id @default(autoincrement())
  recepcionId Int
  recepcion   Recepcion @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  nombre      String
  mime        String
  tamano      Int // bytes
  subidoEn    DateTime  @default(now())
  subidoPor   String // Usuario

  contenido RecepcionAdjuntoContenido?

  @@index([recepcionId])
  @@map("recepcion_adjuntos")
}

model RecepcionAdjuntoContenido {
  adjuntoId Int              @id
  adjunto   RecepcionAdjunto @relation(fields: [adjuntoId], references: [id], onDelete: Cascade)
  datos     Bytes

  @@map("recepcion_adjuntos_contenido")
}

model Pallet {
  id          Int       @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  recepcionId Int
  // FK compuesta (empresaId, recepcionId) -> Recepcion(empresaId, id).
  recepcion   Recepcion @relation(fields: [empresaId, recepcionId], references: [empresaId, id])

  numeroPallet String // identificador de origen — usado para reconciliar con Packing List (ventas.md)
  origen       OrigenRecepcion // heredado de Recepcion.origen
  // embarqueId se agrega cuando exista el modelo Embarque (ventas.md, aún diferido)

  productorId Int // Entidad tipo PRODUCTOR
  // FK compuesta (empresaId, productorId) -> Entidad(empresaId, id).
  productor   Entidad @relation("PalletProductor", fields: [empresaId, productorId], references: [empresaId, id])

  lineas PalletLinea[]

  creadoEn DateTime @default(now())

  @@index([recepcionId])
  @@index([productorId])
  @@index([empresaId])
  @@map("pallets")
}

model PalletLinea {
  id       Int    @id @default(autoincrement())
  palletId Int
  pallet   Pallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  especieId   Int
  especie     Especie   @relation(fields: [especieId], references: [id])
  variedadId  Int
  variedad    Variedad  @relation(fields: [variedadId], references: [id])
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  articuloId  Int // FK → Artículo tipo EMBALAJE
  articulo    Articulo  @relation(fields: [articuloId], references: [id])
  calibreId   Int
  calibre     Calibre   @relation(fields: [calibreId], references: [id])

  cajas Int

  @@index([palletId])
  @@map("pallet_lineas")
}

// ─── TEMPLATES DE CARGA (compras.md §9.2 — mapeo Excel por planta/origen) ─────

model TemplateCarga {
  id                 Int     @id @default(autoincrement())
  empresaId          Int
  empresa            Empresa @relation(fields: [empresaId], references: [id])
  codigo             String
  // Whitelist en código (TIPOS_TEMPLATE_CARGA), no enum Prisma — mismo
  // criterio que `campo` abajo: agregar un tipo nuevo no debe requerir
  // migración. Inmutable tras crear (ver templates-carga.schema.ts).
  tipo               String
  descripcion        String
  tieneCabecera      Boolean @default(true)
  filaCabecera       Int? // requerido si tieneCabecera = true
  filaPrimerRegistro Int
  bloqueado          Boolean @default(false)

  campos      TemplateCargaCampo[]
  recepciones Recepcion[]

  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([empresaId, id])
  @@index([eliminadoEn])
  @@index([empresaId])
  @@map("templates_carga")
}

// `campo` usa una whitelist validada en el backend (no enum Prisma) para poder
// ampliar la lista de campos mapeables sin migración — mismo patrón que
// MODELOS_CON_CODIGO en el módulo Prefijos de Código.
model TemplateCargaCampo {
  id              Int           @id @default(autoincrement())
  templateCargaId Int
  templateCarga   TemplateCarga @relation(fields: [templateCargaId], references: [id], onDelete: Cascade)

  campo   String // NUMERO_PALLET | ESPECIE | VARIEDAD | CATEGORIA | ARTICULO | CALIBRE | CAJAS | PRODUCTOR
  columna String // nombre de cabecera (si tieneCabecera=true) o letra de columna Excel A/B/C... (si false)

  @@unique([templateCargaId, campo])
  @@map("templates_carga_campos")
}

// ─── Motor de Documentos — Etapa 4 (Docs/agrosan_etapa4_motor_documentos.md) ──
// Un solo registro por documento EMITIDO (no por preview — el preview no
// persiste nada, se renderiza al vuelo). `payload` es la foto congelada de
// los datos al momento de emitir (§4 del doc: "por qué el snapshot no es
// opcional") — la reimpresión usa ESTE payload + `plantillaVersion`, nunca
// vuelve a consultar el estado actual del documento origen. `pdf` guarda el
// binario ya renderizado (mismo patrón bytea que RecepcionAdjuntoContenido/
// adjuntos de Solicitud — no se agregó MinIO/S3 para esta etapa inicial).
model DocumentoEmitido {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  tipo             String // código del DOCUMENT_REGISTRY, ej. 'orden-compra'
  documentoId      Int // id del registro origen (ej. OrdenCompra.id) — sin FK propia, cada tipo referencia una tabla distinta
  plantillaVersion String // ej. 'v1' — las versiones viejas de plantilla nunca se editan (§4)
  folio            String // para armar el nombre de archivo / búsqueda humana
  payload          Json // snapshot Zod-validado al momento de emitir
  pdf              Bytes
  hashSha256       String // idempotencia: reemite el mismo payload -> mismo hash, no duplica

  creadoEn  DateTime @default(now())
  creadoPor String

  // Defensa en profundidad (DOC-QA-003, ronda 2) — el mecanismo primario de
  // idempotencia es el advisory lock en documentos.repository.ts
  // (LOCK_NAMESPACE_DOCUMENTOS_EMISION); esta constraint evita duplicados
  // incluso si algún camino de código futuro se saltara el lock.
  @@unique([empresaId, tipo, documentoId, plantillaVersion, hashSha256])
  @@index([tipo, documentoId])
  @@map("documentos_emitidos")
}
