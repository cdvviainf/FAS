NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fas_user:fas_pass@localhost:5433/fas_db
REDIS_URL=redis://:fas_redis_pass@localhost:6379
BETTER_AUTH_SECRET=<minimo_32_caracteres>
BETTER_AUTH_URL=http://localhost:3001
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@agrosan.cl
DTE_PROVIDER=mock
# DTE_PROVIDER=chilesystems
# DTE_API_URL=https://api.chilesystems.cl
# DTE_API_KEY=xxxx
# DTE_RUT_EMISOR=76.XXX.XXX-X
# DTE_PROVIDER=libredte
DTE_AMBIENTE=certificacion
# o produccion — solo aplica al proveedor 'libredte' por ahora
# La URL y el hash de LibreDTE NO van acá: se configuran en el mantenedor de
# Integraciones (Configuración → Integraciones, código 'LIBREDTE'), igual que
# AGL360. Las variables siguientes son SOLO para el script de prueba
# `tsx prisma/test-libredte-dte.ts` (crea esa Integración si no existe):
# LIBREDTE_API_HASH=<hash de tu perfil LibreDTE>
# LIBREDTE_URL=https://libredte.cl
# LIBREDTE_RUT_EMISOR=76192083-9
# LIBREDTE_RUT_RECEPTOR=66666666-6
AGL_PROVIDER=mock
# AGL_PROVIDER=agl360
AGL360_WEBHOOK_SECRET=<minimo_16_caracteres>
RECLAMOS_API_KEY=<minimo_16_caracteres>
CORS_ORIGIN=http://localhost:3000
